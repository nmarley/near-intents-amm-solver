{
  "name": "near-intents-amm-solver",
  "version": "0.0.1",
  "description": "AMM Solver is a sample solver for the Near Intents protocol, implementing Automated Market Maker functionality for a given pair of NEP-141 tokens.",
  "scripts": {
    "format": "bun --bun run biome check ./src ./test --write --unsafe",
    "start": "node -r tsconfig-paths/register -r ts-node/register src/main.ts",
    "dev": "node -r tsconfig-paths/register -r ts-node/register --watch src/main.ts",
    "lint": "format",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@phala/dstack-sdk": "^0.5.5",
    "big.js": "^6.2.2",
    "borsh": "^2.0.0",
    "borsher": "^3.5.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "joi": "^17.13.3",
    "near-api-js": "^4.0.3",
    "near-seed-phrase": "^0.2.1",
    "near-units": "^0.1.9",
    "node-cache": "^5.1.2",
    "p-retry": "^7.0.0",
    "winston": "^3.3.3",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/big.js": "^6.2.2",
    "@types/bun": "latest",
    "@types/jest": "^29.5.14",
    "@types/ws": "^8.5.11",
    "globals": "^15.14.0",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^3.10.1",
    "typescript": "^5.7.3"
  }
}
